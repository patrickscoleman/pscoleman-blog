{
  "name": "pscoleman-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4321",
    "build": "next build",
    "check:output": "node scripts/check-output.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4321",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint src scripts",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:content && npm run check:levels && npm run check:portrait",
    "format": "prettier --write src scripts *.json *.mjs README.md AGENTS.md",
    "format:check": "prettier --check src scripts *.json *.mjs README.md AGENTS.md",
    "check:levels": "node scripts/check-language-levels.mjs",
    "generate:portrait": "node scripts/compose-portrait.mjs && node scripts/generate-portrait-vectors.mjs",
    "check:portrait": "node scripts/check-portrait.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@vercel/functions": "3.10.1",
    "marked": "18.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
